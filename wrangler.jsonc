{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jetpack-mechanics-lab-beta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  // The built lab is the page. The Worker only runs for /api/* so static
  // files stay on the asset path and are not billed as Worker invocations.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CHANNEL": "beta",
    "VERSION": "0.1.0"
  },
  "observability": {
    "enabled": true
  }
}
